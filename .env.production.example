LOCAL_MODE=False
APP_NAME=KnowTrace
APP_ENV=production
DEBUG=False
API_PREFIX=/api/v1

BACKEND_CORS_ORIGINS=https://your-domain.example

DASHSCOPE_API_KEY=replace-with-real-key-on-server
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=qwen3.7-text-embedding

MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.docx

MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_qwen37_1024
MILVUS_DIMENSION=1024

REDIS_URL=redis://redis:6379/0
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rag_user
RABBITMQ_PASSWORD=replace-with-strong-password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-strong-access-key
MINIO_SECRET_KEY=replace-with-strong-secret-key
MINIO_BUCKET_NAME=rag-documents-demo
MINIO_SECURE=False

DATABASE_URL=sqlite:///./data/rag_system.db

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=20
ENABLE_RERANK=True
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=5
ENABLE_MULTI_HOP=True
MAX_HOP=3
SHORT_TERM_MEMORY_TTL=3600
MEMORY_HISTORY_LIMIT=10
LLM_ENABLE_THINKING=False
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_BATCH_SIZE=20

# Optional: use the API address from your Beijing workspace when required.
# DASHSCOPE_HTTP_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
# DASHSCOPE_WORKSPACE_ID=YOUR_WORKSPACE_ID
